    <path d="M58 24 Q68 34 78 24 M58 36 Q68 26 78 36" stroke="#7a1f3d" stroke-width="2.2" fill="none"/>
  </g>
  <!-- Wordmark -->
  <text x="140" y="56" font-family="Segoe UI, Arial, sans-serif" font-size="33" font-weight="800" fill="#0a2540" letter-spacing="-0.5">CORPORACIÓN</text>
